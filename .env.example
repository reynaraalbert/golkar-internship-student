# Konfigurasi Koneksi Supabase PostgreSQL
# Dapatkan DATABASE_URL dan DIRECT_URL dari Dashboard Supabase Anda:
# Project Settings -> Database -> Connection string -> URI / Direct connection

DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=6"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Rahasia sesi admin (ganti dengan string acak panjang, minimal 32 karakter)
ADMIN_JWT_SECRET=""
# Kredensial login admin (jangan gunakan nilai default)
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Rahasia sesi peserta (ganti dengan string acak panjang, minimal 32 karakter)
USER_JWT_SECRET=""

# Email pengiriman tautan reset kata sandi (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Golkar Internship Student <onboarding@resend.dev>"

# URL publik situs (dipakai untuk tautan reset, metadata, canonical, og:url)
NEXT_PUBLIC_SITE_URL="https://golkar-internship-student.vercel.app"

# Supabase Storage (opsional, untuk unggah berkas via /api/upload)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
