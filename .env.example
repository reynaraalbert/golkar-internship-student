# Konfigurasi Koneksi Supabase PostgreSQL
# Dapatkan DATABASE_URL dan DIRECT_URL dari Dashboard Supabase Anda:
# Project Settings -> Database -> Connection string -> URI / Direct connection

DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgboouncer=true&connection_limit=6"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Rahasia Sesi Admin Auth (ganti dengan string acak yang panjang dan aman)
ADMIN_JWT_SECRET="your-super-secret-jwt-key-here"

# Kredensial Login Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here
