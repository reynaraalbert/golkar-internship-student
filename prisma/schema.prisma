datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model NewsArticle {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  category    String
  date        String
  readTime    String
  author      String
  summary     String
  content     String   @db.Text
  imageUrl    String
  documentUrl String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgendaItem {
  id             String   @id @default(uuid())
  title          String
  type           String
  partner        String
  date           String
  time           String
  location       String
  status         String
  summary        String   @db.Text
  streamUrl      String?
  pdfDownloadUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Member {
  id           String   @id @default(uuid())
  nomorAnggota String
  name         String
  role         String
  fraksi       String
  dapil        String
  photoUrl     String
  email        String
  bio          String   @db.Text
  billsLed     Json
  pendidikan   String?
  masaJabatan  String?
  komisi       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


model MitraKerja {
  id             String   @id @default(uuid())
  name           String
  acronym        String
  ministerOrHead String
  focusArea      String
  logoUrl        String
  description    String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Aspirasi {
  id        String   @id @default(uuid())
  mode      String
  name      String?
  email     String?
  whatsapp  String?
  subject   String
  message   String   @db.Text
  category  String
  status    String   @default("new")
  createdAt String
}

model NewsSubmission {
  id             String   @id @default(uuid())
  biodata        Json
  artikel        Json
  attachments    Json
  status         String   @default("pending")
  proofreadNotes String?
  createdAt      String
}

model PageContent {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  sections  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteStat {
  id                   String   @id @default("default-stats")
  totalMembers         Int
  totalPimpinan        Int
  mitraKerjaCount      Int
  activeBills          Int
  completedHearings    Int
  aspirationsProcessed Int
  updatedAt            DateTime @updatedAt
}

model StudentUser {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  passwordHash     String
  university       String
  major            String
  phone            String   @default("")
  whatsapp         String?
  domisili         String?
  photoUrl         String   @default("")
  statusMagang     String   @default("Belum Melamar")
  posisiDilamar    String   @default("")
  nim              String?
  ipk              String?
  semester         String?
  bio              String?  @db.Text
  cvUrl            String?
  tipeInstitusi    String?
  programPendidikan String?
  statusPtnPts     String?
  lokasiKampus     String?
  fakultas         String?
  socialMedia      Json?
  documents        Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  experiences      UserExperience[]
}

model UserExperience {
  id            String      @id @default(uuid())
  studentUserId String
  type          String
  title         String
  role          String      @default("")
  startDate     String      @default("")
  endDate       String      @default("")
  isCurrent     Boolean     @default(false)
  description   String      @db.Text @default("")
  url           String?
  createdAt     DateTime    @default(now())
  studentUser   StudentUser @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
}
